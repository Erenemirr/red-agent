# --- Gemini (Google AI Studio — ücretsiz tier) ---
# https://aistudio.google.com adresinden alın
GEMINI_API_KEY=
# Not: gemini-2.0-flash bazı bölgelerde free-tier limit:0 — 2.5-flash'ta kota var
GEMINI_MODEL=gemini-2.5-flash

# --- Arize Phoenix Cloud (ücretsiz SaaS) ---
# Key: Settings > API Keys > System Key. Auth: Authorization: Bearer <key>
PHOENIX_API_KEY=
# ÖNEMLİ: Genel adres değil, Settings > General > Hostname'deki SPACE'e özel URL
# (örn. https://app.phoenix.arize.com/s/<kullanici>). Genel adres 401 verir.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/KULLANICI_ADIN
PHOENIX_PROJECT_NAME=red-team-agent

# --- MLflow (opsiyonel) ---
MLFLOW_TRACKING_URI=

# --- Döngü ayarları ---
MAX_ROUNDS=10
# Çok-turlu saldırı: bir kampanyada (tek hedef+teknik) max konuşma turu. 1 = tek-tur.
MAX_TURNS=3
CRITICAL_SCORE_THRESHOLD=0.8
CRITICAL_FINDINGS_FOR_INTERRUPT=3
SUCCESS_SCORE_THRESHOLD=0.6
# Epsilon-greedy keşif oranı (0=hep exploit, 1=hep keşif). Tek kazanana sıkışmayı önler.
EXPLORE_EPSILON=0.3

# --- LLM temperature ---
ATTACKER_TEMPERATURE=0.9
JUDGE_TEMPERATURE=0.0
TARGET_TEMPERATURE=0.7

# --- Free-tier tasarruf kontrolleri ---
# Her Gemini çağrısının üreteceği maksimum token (token bütçesini kapar)
GEMINI_MAX_OUTPUT_TOKENS=1024
# Rule-based katman kesin ihlal yakaladıysa LLM judge çağrısını atla
SKIP_LLM_JUDGE_ON_RULE_HIT=true

# --- 429 (kota) dayanıklılığı ---
# 429/RESOURCE_EXHAUSTED alınırsa kaç kez yeniden denensin (0=deneme yok)
GEMINI_MAX_RETRIES=5
# Üstel backoff taban gecikmesi (sn); sunucu retryDelay verirse o önceliklidir
GEMINI_RETRY_BASE_DELAY=2.0
# Tek bir backoff beklemesinin üst sınırı (sn)
GEMINI_RETRY_MAX_DELAY=60
# Proaktif hız sınırı — dakikada çağrı (RPM). 0=kapalı (retry+backoff yeter).
# Free-tier gemini-2.5-flash ~5 RPM: 5 verirsen 429 hiç oluşmaz ama run yavaşlar.
GEMINI_RPM=0

# --- API güvenliği (FastAPI) ---
# İstemcilerin /scan /resume için X-API-Key header'ında göndereceği anahtar.
# BOŞ bırakılırsa auth KAPALIDIR (dev/mock/test). Prod'da mutlaka doldurun.
API_KEY=
# İstemci (IP) başına dakikadaki maksimum istek. 0 = rate limit kapalı.
RATE_LIMIT_PER_MINUTE=60

# --- Genel ---
LOG_LEVEL=INFO
ENABLE_TRACING=true
