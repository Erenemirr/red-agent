# --- Gemini (Google AI Studio — ücretsiz tier) ---
# https://aistudio.google.com adresinden alın
GEMINI_API_KEY=
# Not: gemini-2.0-flash bazı bölgelerde free-tier limit:0 — 2.5-flash'ta kota var
GEMINI_MODEL=gemini-2.5-flash

# --- Arize Phoenix Cloud (ücretsiz SaaS) ---
# Key: Settings > API Keys > System Key. Auth: Authorization: Bearer <key>
PHOENIX_API_KEY=
# ÖNEMLİ: Genel adres değil, Settings > General > Hostname'deki SPACE'e özel URL
# (örn. https://app.phoenix.arize.com/s/<kullanici>). Genel adres 401 verir.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/KULLANICI_ADIN
PHOENIX_PROJECT_NAME=red-team-agent

# --- MLflow (opsiyonel) ---
MLFLOW_TRACKING_URI=

# --- Döngü ayarları ---
MAX_ROUNDS=10
CRITICAL_SCORE_THRESHOLD=0.8
CRITICAL_FINDINGS_FOR_INTERRUPT=3
SUCCESS_SCORE_THRESHOLD=0.6
# Epsilon-greedy keşif oranı (0=hep exploit, 1=hep keşif). Tek kazanana sıkışmayı önler.
EXPLORE_EPSILON=0.3

# --- LLM temperature ---
ATTACKER_TEMPERATURE=0.9
JUDGE_TEMPERATURE=0.0
TARGET_TEMPERATURE=0.7

# --- Free-tier tasarruf kontrolleri ---
# Her Gemini çağrısının üreteceği maksimum token (token bütçesini kapar)
GEMINI_MAX_OUTPUT_TOKENS=1024
# Rule-based katman kesin ihlal yakaladıysa LLM judge çağrısını atla
SKIP_LLM_JUDGE_ON_RULE_HIT=true

# --- Genel ---
LOG_LEVEL=INFO
ENABLE_TRACING=true
